{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 8,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "temperature", "custom/gpu", "memory", "pulseaudio", "network", "battery", "tray"],
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": false,
        "persistent-workspaces": {
            "*": 5
        }
    },
    "hyprland/window": {
        "max-length": 70,
        "separate-outputs": true
    },
    "clock": {
        "format": "{:%a, %b %d  %H:%M}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "interval": 2,
        "format": "cpu {usage}%"
    },
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input",
        "interval": 2,
        "warning-threshold": 75,
        "critical-threshold": 85,
        "format": "cpu {temperatureC}C"
    },
    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits | tr -d ',' | xargs printf 'gpu %s%% %s/%s MiB\\n'",
        "interval": 2,
        "tooltip": false
    },
    "memory": {
        "interval": 2,
        "format": "ram {percentage}% swap {swapPercentage}%"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "muted",
        "format-icons": {
            "default": ["vol", "vol", "vol"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "network": {
        "format-wifi": "wifi {signalStrength}%",
        "format-ethernet": "wired",
        "format-disconnected": "offline",
        "tooltip-format": "{ifname}: {ipaddr}"
    },
    "battery": {
        "bat": "BAT1",
        "format": "bat {capacity}%",
        "format-charging": "charging {capacity}%",
        "format-plugged": "plugged {capacity}%",
        "format-critical": "low {capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        }
    },
    "tray": {
        "spacing": 10
    }
}
